<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
  version="4.0">
  <display-name>booking</display-name>

  <servlet>
    <servlet-name>aboutPage</servlet-name>
    <jsp-file>/aboutus.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>contactPage</servlet-name>
    <jsp-file>/ContactUs.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>userLoginPage</servlet-name>
    <jsp-file>/pages/user.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>servicesPage</servlet-name>
    <jsp-file>/pages/services.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>galleryPage</servlet-name>
    <jsp-file>/pages/Gallery.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>appointmentPage</servlet-name>
    <jsp-file>/pages/appointment.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>hairPage</servlet-name>
    <jsp-file>/pages/hair.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>makeupPage</servlet-name>
    <jsp-file>/pages/makeup.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>nailPage</servlet-name>
    <jsp-file>/pages/nail.jsp</jsp-file>
  </servlet>

  <servlet-mapping>
    <servlet-name>aboutPage</servlet-name>
    <url-pattern>/aboutus</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>contactPage</servlet-name>
    <url-pattern>/ContactUs</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>userLoginPage</servlet-name>
    <url-pattern>/pages/user</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>servicesPage</servlet-name>
    <url-pattern>/pages/services</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>galleryPage</servlet-name>
    <url-pattern>/pages/Gallery</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>appointmentPage</servlet-name>
    <url-pattern>/pages/appointment</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>appointmentPage</servlet-name>
    <url-pattern>/pages/appointments</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>hairPage</servlet-name>
    <url-pattern>/pages/hair</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>makeupPage</servlet-name>
    <url-pattern>/pages/makeup</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>nailPage</servlet-name>
    <url-pattern>/pages/nail</url-pattern>
  </servlet-mapping>

  <welcome-file-list>
    <welcome-file>pages/index.jsp</welcome-file>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>
</web-app>
