<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <servlet>
        <servlet-name>hair</servlet-name>
        <jsp-file>/pages/hair.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>hair</servlet-name>
        <url-pattern>/hair</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>nail</servlet-name>
        <jsp-file>/pages/nail.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>nail</servlet-name>
        <url-pattern>/nail</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>makeup</servlet-name>
        <jsp-file>/pages/makeup.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>makeup</servlet-name>
        <url-pattern>/makeup</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>appointment</servlet-name>
        <jsp-file>/pages/appointment.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>appointment</servlet-name>
        <url-pattern>/appointment</url-pattern>
    </servlet-mapping>

</web-app>