<%-- 
  Navigation sidebar for the admin portal. 
  It stays sticky on the left so admins can jump between sections easily.
--%>
<aside class="admin-sidebar">
    <div class="admin-brand">
        <p class="admin-kicker">Shringar</p>
        <h1>Salon Admin</h1>
        <span>Appointments, customer approvals, service records, and contact flow in one control room.</span>
    </div>

    <%-- Main navigation links --%>
    <nav class="admin-nav" aria-label="Admin sections">
        <p class="admin-nav-group">Main</p>
        <%-- We use the activePage variable to highlight which section the user is currently in --%>
        <a class="admin-nav-link ${activePage eq 'dashboard' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/dashboard"><i class="fa fa-tachometer"></i> Overview</a>
        <a class="admin-nav-link ${activePage eq 'users' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/users"><i class="fa fa-users"></i> Users</a>
        <a class="admin-nav-link ${activePage eq 'services' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/services"><i class="fa fa-scissors"></i> Services</a>
        <a class="admin-nav-link ${activePage eq 'bookings' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/bookings"><i class="fa fa-calendar-check-o"></i> Bookings</a>
        <a class="admin-nav-link ${activePage eq 'requests' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/requests"><i class="fa fa-bell-o"></i> Requests</a>
        <a class="admin-nav-link ${activePage eq 'messages' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/messages"><i class="fa fa-envelope-o"></i> Enquiries</a>
        
        <p class="admin-nav-group">Access</p>
        <%-- Quick links to go back to the public site or sign out --%>
        <a class="admin-nav-link" href="${pageContext.request.contextPath}/"><i class="fa fa-home"></i> Salon Home</a>
        <a class="admin-nav-link" href="${pageContext.request.contextPath}/logout"><i class="fa fa-sign-out"></i> Logout</a>
    </nav>
</aside>
